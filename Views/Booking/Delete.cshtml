
@model HotelBoking.Booking

@{
    ViewBag.Title = "Xóa đặt phòng";
}

<section class="container section">
    <div class="card p-4" style="max-width:600px; margin:auto">

        <h2>Xóa đặt phòng</h2>
        <hr />

        <p class="text-danger">
            Bạn có chắc chắn muốn xóa đặt phòng này không?
        </p>

        <dl class="dl-horizontal">

            <dt>Mã đặt phòng</dt>
            <dd>@Model.ID</dd>

            <dt>Ngày đặt</dt>
            <dd>
                @(Model.DateBooking.HasValue
                    ? Model.DateBooking.Value.ToString("dd/MM/yyyy")
                    : "")
            </dd>

            <dt>Khách hàng</dt>
            <dd>
                @(Model.Customer != null
                    ? Model.Customer.NameCus
                    : "Chưa có thông tin")
            </dd>

            <dt>Địa chỉ</dt>
            <dd>
                @(string.IsNullOrEmpty(Model.AddressDelivery)
                    ? "Chưa cung cấp"
                    : Model.AddressDelivery)
            </dd>

        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ID)

            <button type="submit" class="btn btn-danger">
                Xác nhận xóa
            </button>

            @Html.ActionLink(
                "Hủy",
                "Index",
                null,
                new { @class = "btn btn-secondary" })
        }

    </div>
</section>
