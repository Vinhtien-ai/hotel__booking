@model HotelBoking.Booking

@{
    ViewBag.Title = "Thanh toán";
    double total = Model.BookingDetails != null
        ? Model.BookingDetails.Sum(x => x.Quantity * x.UnitPrice) ?? 0
        : 0;
}

<div class="container mt-5 mb-5">
    <div class="card shadow-sm mx-auto" style="max-width: 720px;">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Thanh toán đặt phòng</h3>
        </div>
        <div class="card-body">
            <p>Đơn đặt phòng: <strong>#@Model.ID</strong></p>
            <p>Tổng tiền: <strong class="text-danger">@String.Format("{0:N0} VNĐ", total)</strong></p>
            

            @using (Html.BeginForm("Pay", "Booking", new { id = Model.ID }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-lg w-100">
                    Xác nhận thanh toán
                </button>
            }

            <a href="@Url.Action("Details", "Booking", new { id = Model.ID })"
               class="btn btn-outline-secondary w-100 mt-2">
                Quay lại thông tin đặt phòng
            </a>
        </div>
    </div>
</div>
