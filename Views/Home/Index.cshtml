@{ ViewBag.Title = "Trang chủ"; }
<section class="home-hero"><div class="container hero-content"><div class="eyebrow">Chào mừng đến Lumière Hotel · Sài Gòn</div><h1>Nơi những khoảnh khắc<br/><em>trở nên đáng nhớ.</em></h1><p>Khám phá không gian nghỉ dưỡng thanh lịch, nơi sự thoải mái và tinh tế gặp nhau.</p><div class="d-flex flex-wrap gap-3">@Html.ActionLink("Khám phá phòng nghỉ","Index","Room",null,new{@class="btn btn-brand btn-lg"})<a href="#experience" class="btn btn-outline-brand btn-lg">Về Lumière</a></div></div><div class="hero-caption">A refined stay · A beautiful memory</div></section>
<section class="container search-strip"><div class="row g-3"><div class="col-md-4 search-strip-item"><span class="strip-label">Trải nghiệm</span><strong>Không gian thư thái</strong></div><div class="col-md-4 search-strip-item"><span class="strip-label">Phong cách</span><strong>Thanh lịch & hiện đại</strong></div><div class="col-md-4 search-strip-item"><span class="strip-label">Dành cho</span><strong>Cặp đôi · Gia đình · Công tác</strong></div></div></section>
<section class="section container"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="eyebrow">Không gian lưu trú</div><h2 class="section-heading">Phòng nghỉ nổi bật</h2><p class="section-subtitle mb-0">Chọn căn phòng phù hợp cho kỳ nghỉ tiếp theo của bạn.</p></div>@Html.ActionLink("Xem tất cả phòng →","Index","Room",null,new{@class="text-decoration-none fw-semibold text-success"})</div>
<div class="row g-4">
<div class="col-md-6 col-lg-4"><div class="card room-card"><img class="room-card-image" src="~/Images/phong-tieu-chuan.jpg" alt="Phòng tiêu chuẩn"/><div class="card-body"><div class="room-type">Standard Room</div><h3 class="card-title">Phòng Tiêu Chuẩn</h3><p class="room-meta">♧ 2 khách · 25 m² · Wi-Fi miễn phí</p><div class="d-flex justify-content-between align-items-center"><div class="price">850.000 đ<small> / đêm</small></div>@Html.ActionLink("Chi tiết","Details","Room",new{id=1},new{@class="btn btn-outline-brand btn-sm"})</div></div></div></div>
<div class="col-md-6 col-lg-4"><div class="card room-card"><img class="room-card-image" src="~/Images/phong-doi.jpg" alt="Phòng đôi"/><div class="card-body"><div class="room-type">Deluxe Room</div><h3 class="card-title">Phòng Deluxe Đôi</h3><p class="room-meta">♧ 2 khách · 32 m² · View thành phố</p><div class="d-flex justify-content-between align-items-center"><div class="price">1.250.000 đ<small> / đêm</small></div>@Html.ActionLink("Chi tiết","Details","Room",new{id=2},new{@class="btn btn-outline-brand btn-sm"})</div></div></div></div>
<div class="col-md-6 col-lg-4"><div class="card room-card"><img class="room-card-image" src="~/Images/phong-gia-dinh.jpg" alt="Phòng gia đình"/><div class="card-body"><div class="room-type">Family Suite</div><h3 class="card-title">Phòng Gia Đình</h3><p class="room-meta">♧ 4 khách · 48 m² · Không gian rộng</p><div class="d-flex justify-content-between align-items-center"><div class="price">1.850.000 đ<small> / đêm</small></div>@Html.ActionLink("Chi tiết","Details","Room",new{id=3},new{@class="btn btn-outline-brand btn-sm"})</div></div></div></div>
</div></section>
<section id="experience" class="experience-section"><div class="container experience-inner"><div class="eyebrow">Lumière experience</div><h2 class="section-heading">Nghỉ ngơi theo cách<br/>bạn xứng đáng.</h2><p>Không chỉ là một nơi lưu trú — là khoảng lặng để nạp lại năng lượng, tận hưởng từng phút giây và tạo nên kỷ niệm đẹp.</p>@Html.ActionLink("Bắt đầu hành trình","Index","Booking",null,new{@class="btn btn-brand"})</div></section>
<section class="container section"><div class="row align-items-center g-4"><div class="col-lg-6"><img class="detail-image" src="~/Images/hotel2.jpg" alt="Không gian Lumière"/></div><div class="col-lg-6"><div class="eyebrow">Dịch vụ chu đáo</div><h2 class="section-heading">Sự tinh tế trong<br/>từng trải nghiệm.</h2><p class="section-subtitle">Từ những căn phòng được chăm chút đến dịch vụ thân thiện, Lumière mong muốn mang đến cho bạn một kỳ lưu trú nhẹ nhàng và trọn vẹn.</p><div class="row g-3 mt-2"><div class="col-6"><div class="feature-chip">✓ Lễ tân thân thiện</div></div><div class="col-6"><div class="feature-chip">✓ Phòng sạch mỗi ngày</div></div><div class="col-6"><div class="feature-chip">✓ Wi-Fi tốc độ cao</div></div><div class="col-6"><div class="feature-chip">✓ Không gian thư giãn</div></div></div></div></div></section>