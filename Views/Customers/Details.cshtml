@model HotelBoking.Customer
@{ ViewBag.Title = "Chi tiết khách hàng"; }
<h2>Chi tiết khách hàng</h2>
<dl class="dl-horizontal">
    <dt>Mã khách hàng</dt><dd>@Model.IDCus</dd>
    <dt>Họ tên</dt><dd>@Model.NameCus</dd>
    <dt>Số điện thoại</dt><dd>@Model.PhoneCus</dd>
    <dt>Email</dt><dd>@Model.EmailCus</dd>
</dl>
<p>@Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })</p>
