```cshtml
@model HotelBoking.HotelRoom

@{
    ViewBag.Title = "Xóa phòng nghỉ";
}

<h2>Xóa phòng nghỉ</h2>

<h3>Bạn có chắc chắn muốn xóa phòng này?</h3>

<div>
    <hr />

    <dl class="dl-horizontal">
        <dt>Mã phòng</dt>
        <dd>
            @Html.DisplayFor(model => model.RoomID)
        </dd>

        <dt>Tên phòng</dt>
        <dd>
            @Html.DisplayFor(model => model.NameRoom)
        </dd>

        <dt>Loại phòng</dt>
        <dd>
            @(Model.RoomType1 != null
                ? Model.RoomType1.NameType
                : Model.RoomType)
        </dd>

        <dt>Giá phòng</dt>
        <dd>
            @Html.DisplayFor(model => model.Price)
        </dd>

        <dt>Mô tả phòng</dt>
        <dd>
            @Html.DisplayFor(model => model.DescriptionRoom)
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.RoomID)

        <input type="submit" value="Xóa phòng"
               class="btn btn-danger" />

        @Html.ActionLink("Quay lại danh sách", "Index",
            null, new { @class = "btn btn-default" })
    }
</div>
```