```cshtml
@model HotelBoking.HotelRoom

@{
    ViewBag.Title = "Chi tiết phòng nghỉ";
}

<h2>Chi tiết phòng nghỉ</h2>

<div>
    <hr />

    <dl class="dl-horizontal">
        <dt>Mã phòng</dt>
        <dd>
            @Html.DisplayFor(model => model.RoomID)
        </dd>

        <dt>Tên phòng</dt>
        <dd>
            @Html.DisplayFor(model => model.NameRoom)
        </dd>

        <dt>Loại phòng</dt>
        <dd>
            @(Model.RoomType1 != null
                ? Model.RoomType1.NameType
                : Model.RoomType)
        </dd>

        <dt>Giá phòng</dt>
        <dd>
            @Html.DisplayFor(model => model.Price)
        </dd>

        <dt>Mô tả</dt>
        <dd>
            @Html.DisplayFor(model => model.DescriptionRoom)
        </dd>

        <dt>Ảnh phòng</dt>
        <dd>
            @if (!string.IsNullOrEmpty(Model.ImageRoom))
            {
                <img src="@Url.Content(Model.ImageRoom)"
                     alt="Ảnh phòng"
                     style="width:250px; height:auto;" />
            }
            else
            {
                <span>Chưa có ảnh</span>
            }
        </dd>
    </dl>
</div>

<p>
    @Html.ActionLink("Chỉnh sửa", "Edit",
        new { id = Model.RoomID },
        new { @class = "btn btn-primary" })

    @Html.ActionLink("Quay lại danh sách", "Index",
        null, new { @class = "btn btn-default" })
</p>
```