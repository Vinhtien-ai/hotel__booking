
@model HotelBoking.RoomType

@{
    ViewBag.Title = "Delete";
}

<h2>Xóa loại phòng</h2>

<h3>Bạn có chắc chắn muốn xóa loại phòng này?</h3>

<div>
    <hr />

    <dl class="dl-horizontal">
        <dt>
            Mã loại phòng
        </dt>

        <dd>
            @Html.DisplayFor(model => model.IDType)
        </dd>

        <dt>
            Tên loại phòng
        </dt>

        <dd>
            @Html.DisplayFor(model => model.NameType)
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.IDType)

        <input type="submit" value="Xóa"
               class="btn btn-danger" />

        @Html.ActionLink("Quay lại danh sách",
            "Index", null, new { @class = "btn btn-default" })
    }
</div>
